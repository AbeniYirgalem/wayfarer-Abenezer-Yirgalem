# ==============================================================================
# Wayfarer Express Backend Environment Configuration (backend/.env)
# ==============================================================================
# Copy this file to backend/.env when running backend locally on the host machine:
#   Linux/macOS: cp backend/.env.example backend/.env
#   Windows:     Copy-Item backend/.env.example backend/.env
# Note: Not required when running the entire stack via Docker Compose.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Connection URL (host machine connects to Docker PostgreSQL)
# If host port 5432 was mapped to 5433, change port to 5433 below:
DATABASE_URL=postgresql://wayfarer:wayfarer_dev@localhost:5432/wayfarer?schema=public

# Shadow Database URL (only used by Prisma Migrate Dev on host machine)
SHADOW_DATABASE_URL=postgresql://wayfarer:wayfarer_dev@localhost:5432/wayfarer_shadow?schema=public

# Allowed Frontend URL for CORS header origin validation
FRONTEND_URL=http://localhost:3000
