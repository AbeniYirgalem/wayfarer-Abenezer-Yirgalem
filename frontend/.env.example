# ==============================================================================
# Wayfarer Next.js Frontend Environment Configuration (frontend/.env.local)
# ==============================================================================
# Copy this file to frontend/.env.local when running frontend locally on the host machine:
#   Linux/macOS: cp frontend/.env.example frontend/.env.local
#   Windows:     Copy-Item frontend/.env.example frontend/.env.local
# Note: Not required when running the entire stack via Docker Compose.
# ==============================================================================

# Public URL of the Express.js Backend REST API consumed by browser client components
NEXT_PUBLIC_API_URL=http://localhost:5000/api
