generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlaceCategory {
  HISTORY
  FOOD
  NATURE
  CULTURE
  ENTERTAINMENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  reviews  Review[]
  bookings Booking[]

  @@map("users")
}

model Place {
  id           String        @id @default(uuid())
  name         String
  category     PlaceCategory
  description  String        @db.Text
  openingHours String
  imageUrl     String?
  address      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reviews   Review[]
  tourSlots TourSlot[]

  @@index([category])
  @@map("places")
}

model Review {
  id        String   @id @default(uuid())
  placeId   String
  userId    String
  rating    Int
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([placeId])
  @@index([userId])
  @@map("reviews")
}

model TourSlot {
  id        String   @id @default(uuid())
  placeId   String
  startsAt  DateTime
  capacity  Int
  createdAt DateTime @default(now())

  place    Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([placeId])
  @@index([startsAt])
  @@map("tour_slots")
}

model Booking {
  id        String   @id @default(uuid())
  slotId    String
  userId    String
  seats     Int
  createdAt DateTime @default(now())

  tourSlot TourSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([slotId])
  @@index([userId])
  @@map("bookings")
}
