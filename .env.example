# ==============================================================================
# Wayfarer Monorepo Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env in the repository root:
#   Linux/macOS: cp .env.example .env
#   Windows:     Copy-Item .env.example .env
# ==============================================================================

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=wayfarer
POSTGRES_PASSWORD=wayfarer_dev
POSTGRES_DB=wayfarer

# Host port mapping for PostgreSQL (defaults to 5432; change to 5433 if 5432 is in use)
POSTGRES_PORT=5432

# Docker Networking & Client API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Host Development Database URLs (only needed if running Node/Prisma directly on the host machine)
DATABASE_URL="postgresql://wayfarer:wayfarer_dev@localhost:5432/wayfarer?schema=public"
SHADOW_DATABASE_URL="postgresql://wayfarer:wayfarer_dev@localhost:5432/wayfarer_shadow?schema=public"
